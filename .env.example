# =============================================================================
# PrimeMover Orchestrator Configuration
# =============================================================================

# Environment
ENV=development

# =============================================================================
# Component Paths
# Paths to PrimeMover repositories (relative to orchestrator or absolute)
# =============================================================================

# Path to primemover_api repository
PM_API_PATH=../primemover_api

# Path to primemover_runner repository
PM_RUNNER_PATH=../primemover_runner

# Path to primemover_gui repository (embedded in API's Apache)
PM_GUI_PATH=../primemover_gui

# =============================================================================
# Component Ports
# =============================================================================

# API Stack Ports
PM_API_HTTP_PORT=8090
PM_API_MYSQL_PORT=3307
PM_API_REDIS_PORT=8889

# Monitoring Stack Ports
GRAFANA_PORT=3000
LOKI_PORT=3100
PROMETHEUS_PORT=9090
TEMPO_PORT=3200

# =============================================================================
# Runner Configuration
# =============================================================================

# JVM options for runner
RUNNER_JAVA_OPTS="-Xmx2g -Xms512m"

# Spring profile for runner (local, integration, production)
RUNNER_SPRING_PROFILE=local

# =============================================================================
# Grafana Authentication
# =============================================================================
GRAFANA_ADMIN_USER=admin
# SECURITY: Set a strong password - no default in code
GRAFANA_ADMIN_PASSWORD=

# =============================================================================
# Log Paths (relative to docker-compose location or absolute)
# =============================================================================

# Path to primemover_api logs (Laravel)
PM_API_LOG_PATH=../primemover_api/storage/logs

# Path to primemover_runner logs (Java/Logback)
PM_RUNNER_LOG_PATH=../primemover_runner/primemover-runner/log

# Path to runner HAR output (for Lambda responses)
PM_RUNNER_HAR_PATH=../primemover_runner/primemover-runner/out/har

# Infrastructure log paths (MySQL, Apache, PHP)
PM_MYSQL_LOG_PATH=../primemover_api/storage/logs/mysql
PM_APACHE_LOG_PATH=../primemover_api/storage/logs/apache
PM_PHP_LOG_PATH=../primemover_api/storage/logs/php

# =============================================================================
# PrimeMover API Connection
# =============================================================================
PM_API_BASE_URL=http://localhost:8090/api/v1
# SECURITY: Set these via environment variables - no defaults in code
PM_API_EMAIL=
PM_API_PASSWORD=

# =============================================================================
# E2E residential proxy
# =============================================================================
# Needed by the browser-automation e2e paths (`orchestrator e2e` and
# `orchestrator e2e --youtube`). Multilogin validates a profile's proxy when it
# starts the browser -- it fetches proxy.multilogin.com through it -- and refuses
# to launch if that fails, so these must be real working credentials.
#
# The scenario JSONs under orchestrator/e2e/ carry PROXY_*_PLACEHOLDER instead of
# credentials so nothing sensitive is committed; the values below are substituted
# at upload time.
#
# Leave blank to run only `orchestrator e2e --chrome`, which drives plain Chrome
# with no Multilogin and no proxy.
E2E_PROXY_HOST=
E2E_PROXY_PORT=
E2E_PROXY_USERNAME=
E2E_PROXY_PASSWORD=

# =============================================================================
# API Stack Service Credentials (for health checks)
# =============================================================================
# SECURITY: Set these to match your docker-compose configuration
PM_MYSQL_PASSWORD=
PM_REDIS_PASSWORD=

# =============================================================================
# AWS (for CloudWatch Lambda logs)
# =============================================================================
AWS_DEFAULT_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LAMBDA_FUNCTION_NAME=bot-decision-yt
LAMBDA_LOG_GROUP=/aws/lambda/bot-decision-yt

# ex63 edge overlay (docker-compose.ex63.yml, opt-in): PrimeMover Grafana is
# routed at https://pm-ops.${DOMAIN}. Unused by the base compose.
DOMAIN=qamelab.org

# --- MCP server over HTTP (primemover-mcp.service) ---------------------------
# Required in HTTP mode; the server refuses to start without at least one.
# One token PER PERSON, `name:token,name:token`, so each request is logged
# against a name and one person can be revoked without rotating the rest.
# Tokens from `openssl rand -hex 32`. Clients send `Authorization: Bearer <token>`.
# (The older single MCP_AUTH_TOKEN is still accepted, as the name "default".)
MCP_AUTH_TOKENS=
# Bind address. On ex63 this is the host's address on the ex63_internal docker
# bridge, so only the edge Traefik (and the host itself) can reach the port.
MCP_HOST=127.0.0.1
MCP_PORT=8100

# --- Alerting (Grafana unified alerting) -------------------------------------
# Rules live in infrastructure/grafana/provisioning/alerting/ and are picked up
# on a Grafana RESTART. They fire and are visible in the UI with none of the
# variables below set; these only arm *delivery*.
#
# IMPORTANT: docker-compose.yml does not forward any of these into the Grafana
# container today. Setting them here alone changes nothing -- each one also
# needs a line in the grafana service's `environment:` block. See
# infrastructure/grafana/provisioning/alerting/README.md.
#
# Recipient for the primemover-default contact point. Comma-separated. Leaving
# it blank is safe; an EMPTY value referenced as ${PM_ALERT_EMAIL_TO} in a
# contact point is NOT -- Grafana rejects it and then fails to provision the
# alert rules as well. The provisioned default is a literal placeholder for
# exactly that reason.
PM_ALERT_EMAIL_TO=
# Webhook alternative. Required before uncommenting the primemover-webhook
# contact point; uncommenting it with this unset takes all alerting down.
PM_ALERT_WEBHOOK_URL=
# Grafana's own SMTP settings. GF_SMTP_ENABLED=false (the default) is what makes
# the contact point inert: the email notifier becomes a no-op.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
