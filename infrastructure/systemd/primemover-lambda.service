[Unit]
Description=PrimeMover Local Lambda Service
After=network.target

[Service]
Type=simple
User=primemover
Group=primemover
WorkingDirectory=/home/primemover/primemover-orchestrator
EnvironmentFile=/home/primemover/primemover-orchestrator/.env
Environment=PATH=/home/primemover/primemover-orchestrator/venv/bin:/usr/local/bin:/usr/bin:/bin
# Defense in depth against a file-descriptor leak. The decision function's
# OpenAI client was leaking a socket per invocation (fixed in bot-decision-yt),
# and the default soft limit of 1024 turned that into a hard wall after ~500
# calls: every OpenAI call then failed with APIConnectionError and the
# children/entertainment filter silently stopped applying (round 7, 2026-09-01).
# A higher ceiling does not fix a leak -- it only buys time -- but it keeps a
# slow leak or a burst of concurrency from starving the process mid-run.
LimitNOFILE=65536
ExecStart=/home/primemover/primemover-orchestrator/venv/bin/python -m orchestrator.lambda_service.server --port 5001 --host 127.0.0.1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
