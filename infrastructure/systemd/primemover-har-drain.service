[Unit]
Description=PrimeMover job-data archival (MinIO -> Nextcloud)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=primemover
Group=primemover
WorkingDirectory=/home/primemover/primemover-orchestrator
ExecStart=/home/primemover/primemover-orchestrator/scripts/har-drain.sh

# Resource caps: this is a sidecar on a host that also runs the runner + Chrome.
# It must always yield to them. CPUQuota=50% == half a core on this 8-core box;
# idle IO class + Nice keep it off the runner's back; MemoryMax caps rclone/zstd.
# Network is additionally capped via BWLIMIT in har-drain.env.
Nice=10
CPUWeight=20
CPUQuota=50%
IOSchedulingClass=idle
IOSchedulingPriority=7
MemoryMax=512M
TasksMax=64

# Read-only except the buffer, staging, and log dirs.
ProtectSystem=strict
ProtectHome=read-only
# The script no longer touches the runner's directory at all: it reads from
# MinIO over the network and writes only its staging area and log. Listing
# out/har here was also a startup hazard -- systemd refuses to start a unit
# whose ReadWritePaths does not exist, and that directory stopped being
# created when the runner went S3-only (primemover_runner cadb15e).
ReadWritePaths=/home/primemover/primemover-orchestrator/log
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
