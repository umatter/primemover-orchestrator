[Unit]
Description=Multilogin X Agent
After=vncserver@1.service
Requires=vncserver@1.service

[Service]
Type=simple
User=primemover
Group=primemover
Environment=DISPLAY=:1
Environment=HOME=/home/primemover
WorkingDirectory=/home/primemover
ExecStartPre=/bin/sleep 10
ExecStart=/opt/mlx/agent.bin
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
