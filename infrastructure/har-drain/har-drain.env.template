# PrimeMover job-data archival configuration.
#
# Copy to har-drain.env and adjust. har-drain.env is gitignored (it names your
# remote path) — the rclone credentials themselves live in rclone.conf, not here.
#
# NOTE: the source is the MinIO bucket the runner writes to, not a local folder.
# The runner stopped writing job data to local disk in primemover_runner cadb15e
# (storage.local.enabled=false), so the old BUFFER_DIR was always empty and this
# sidecar shipped nothing. MinIO is the system of record; this script copies and
# never deletes from it.

# rclone S3 remote -> the runner's bucket (awsS3.bucketName=primemoverrunner).
SOURCE_REMOTE=minio:primemoverrunner

# Where batches are built before upload, the lock and watermark live, logs go.
STAGING_DIR=/home/primemover/primemover-orchestrator/log/har-drain-staging
STATE_FILE=/home/primemover/primemover-orchestrator/log/har-drain-staging/.last-archived
LOG_FILE=/home/primemover/primemover-orchestrator/log/har-drain.log

# rclone remote + config (see rclone.conf.template).
RCLONE_CONFIG=/home/primemover/primemover-orchestrator/infrastructure/har-drain/rclone.conf
RCLONE_REMOTE=nextcloud:primemover/har

# Ignore objects still being written, so a partial upload is never archived.
MIN_AGE_MIN=2

# Re-scan window on top of the watermark, so an object written during the
# previous run is picked up rather than skipped. Cheap: duplicates are just
# re-archived, gaps are not recoverable without a manual backfill.
SLACK_MIN=30

# First run only (no watermark yet): how far back to reach. The bucket holds
# tens of thousands of objects, so a full backfill is a deliberate act — widen
# this, or delete STATE_FILE, when you actually want one.
INITIAL_MAX_AGE=7d

# rclone bandwidth cap (per second). Keeps the sidecar off the runner's network.
BWLIMIT=20M
TRANSFERS=2

# Warn (never delete) when staging grows past this — signals uploads are failing
# or falling behind. Staging is transient; a large value here means a stuck run.
STAGING_CAP_GB=20
