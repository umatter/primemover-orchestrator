# PrimeMover HAR spool-and-drain configuration.
#
# Copy to har-drain.env and adjust. har-drain.env is gitignored (it names your
# remote path) — the rclone credentials themselves live in rclone.conf, not here.

# Local buffer the runner writes to (export.FileTargetFolder in the runner).
BUFFER_DIR=/home/primemover/primemover_runner/primemover-runner/out/har

# Where archives are built before upload, the lock lives, and logs go.
STAGING_DIR=/home/primemover/primemover-orchestrator/log/har-drain-staging
LOG_FILE=/home/primemover/primemover-orchestrator/log/har-drain.log

# rclone remote + config (see rclone.conf.template).
RCLONE_CONFIG=/home/primemover/primemover-orchestrator/infrastructure/har-drain/rclone.conf
RCLONE_REMOTE=nextcloud:primemover/har

# aggregate = tar batches of settled job folders into one dated archive per run
#             (recommended for Nextcloud — few large objects).
# direct    = upload per-job files verbatim (only for S3-compatible stores).
MODE=aggregate

# Only touch job folders untouched for this many minutes, so we never race the
# runner mid-write. 2 is safe; raise if you see partial folders uploaded.
MIN_AGE_MIN=2

# rclone bandwidth cap (per second). Keeps the sidecar off the runner's network.
BWLIMIT=20M
TRANSFERS=2

# Warn (never delete) when the local buffer grows past this — signals the drain
# is falling behind or Nextcloud is unreachable. Size for your worst-case outage
# x job rate; there is ~30GB free on this host today.
BUFFER_CAP_GB=20

# Cap folders per archive to bound tar memory / archive size.
MAX_DIRS_PER_ARCHIVE=2000
