{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://primemover.io/schemas/experiment-spec.schema.json",
  "title": "PrimeMover Experiment Specification",
  "description": "YAML/JSON schema for defining PrimeMover browser automation experiments",
  "type": "object",
  "required": [
    "crawlers"
  ],
  "properties": {
    "crawlers": {
      "type": "array",
      "description": "Crawler definitions",
      "items": {
        "$ref": "#/definitions/crawler"
      },
      "minItems": 1
    },
    "data_pools": {
      "type": "object",
      "description": "External data pools (CSV/JSON/YAML) referenced by from_pool draws",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "description": "Shorthand: just the source path"
          },
          {
            "$ref": "#/definitions/dataPool"
          }
        ]
      }
    },
    "defaults": {
      "$ref": "#/definitions/defaults"
    },
    "design": {
      "$ref": "#/definitions/design"
    },
    "experiment": {
      "$ref": "#/definitions/experiment"
    },
    "runs_for": {
      "type": "string",
      "description": "Path to the fleet lock this spec adds sessions to, relative to the spec. Its presence makes this a runs spec: no design, no experiment, and no agent/proxy/configuration on a crawler."
    },
    "seed": {
      "type": "integer",
      "description": "Runs spec only: the seed every draw derives from, when --seed is not passed (a runs spec has no design: block to hold design.seed). Never inherited from the base lock."
    },
    "strategy_schemas": {
      "type": "object",
      "description": "Per-strategy JSON Schema for a lambda_select job's treatment block: an inline schema, or a path resolved against the spec's directory",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "templates": {
      "type": "object",
      "description": "Reusable workflow templates",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/workflowItem"
        }
      }
    },
    "version": {
      "type": "string",
      "description": "Specification version",
      "default": "1.0",
      "examples": [
        "1.0"
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "experiment": {
      "type": "object",
      "description": "Experiment metadata",
      "properties": {
        "contact": {
          "type": "string",
          "description": "Contact info for the experiment owner"
        },
        "description": {
          "type": "string",
          "description": "Experiment description"
        },
        "generator": {
          "type": "string",
          "description": "Free-text provenance: what produced this spec"
        },
        "name": {
          "type": "string",
          "description": "Experiment name",
          "minLength": 1
        },
        "runner_user_id": {
          "type": "integer",
          "description": "Runner account that executes this experiment; omit for the default runner (1 = ex63). 3 = the runner-only VM."
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "defaults": {
      "type": "object",
      "description": "Default values inherited by all crawlers",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Default active flag"
        },
        "browser": {
          "type": "string",
          "description": "Browser identification",
          "enum": [
            "mlx",
            "chrome",
            "firefox"
          ],
          "default": "mlx"
        },
        "captcha_mode": {
          "type": "string",
          "description": "Captcha handling mode",
          "enum": [
            "never",
            "always",
            "ondemand"
          ],
          "default": "never"
        },
        "location": {
          "type": "string",
          "description": "Default location code",
          "examples": [
            "US-IL-CHICAGO",
            "US-CA-LOS_ANGELES",
            "DE-BE-BERLIN"
          ]
        },
        "proxy": {
          "$ref": "#/definitions/proxy"
        },
        "proxy_type": {
          "type": "string",
          "description": "Default proxy type",
          "enum": [
            "http",
            "brightdata",
            "oxylabs"
          ],
          "default": "http"
        },
        "selection_type": {
          "type": "string",
          "description": "Default element selection type",
          "enum": [
            "XPATH",
            "CSS",
            "ID",
            "NAME"
          ],
          "default": "XPATH"
        },
        "timezone": {
          "type": "string",
          "description": "Timezone identifier",
          "examples": [
            "America/Chicago",
            "America/New_York",
            "Europe/Berlin"
          ]
        },
        "timezone_utc_offset": {
          "type": "string",
          "description": "UTC offset",
          "pattern": "^[+-]\\d{2}:\\d{2}$",
          "examples": [
            "-06:00",
            "+01:00"
          ]
        },
        "typing_mode": {
          "type": "string",
          "description": "Text input simulation mode",
          "enum": [
            "DIRECT",
            "SIMULATED_KEEPINGTYPOS",
            "SIMULATED_FIXINGTYPOS",
            "SIMULATED_NOTYPOS"
          ],
          "default": "SIMULATED_FIXINGTYPOS"
        }
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "description": "Factorial experimental design",
      "properties": {
        "factors": {
          "type": "object",
          "description": "Factor definitions",
          "additionalProperties": {
            "$ref": "#/definitions/factor"
          },
          "minProperties": 1
        },
        "parameters": {
          "type": "object",
          "description": "Parameter distributions sampled once per crawler",
          "additionalProperties": {
            "$ref": "#/definitions/designParameter"
          }
        },
        "replications": {
          "type": "integer",
          "description": "Number of replications per cell",
          "minimum": 1,
          "default": 1
        },
        "seed": {
          "type": "integer",
          "description": "Random seed for reproducible sampling/design expansion"
        },
        "total_crawlers": {
          "type": "integer",
          "description": "Total crawlers for a stratified design (proportional factor levels)",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "description": "Design type",
          "enum": [
            "factorial"
          ],
          "default": "factorial"
        }
      },
      "additionalProperties": false
    },
    "factor": {
      "type": "object",
      "description": "A factor in the experimental design",
      "properties": {
        "levels": {
          "type": "array",
          "description": "Factor levels",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "value": {},
                  "proportion": {
                    "type": "number",
                    "description": "Stratified-sampling weight for this level"
                  }
                }
              }
            ]
          },
          "minItems": 1
        },
        "maps_to": {
          "type": "object",
          "description": "Parameter path -> {level: value} mapping",
          "additionalProperties": {
            "type": "object",
            "description": "Level-to-value mapping"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "levels"
      ]
    },
    "crawler": {
      "type": "object",
      "description": "Crawler definition (a fleet spec's, or a runs spec's)",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Whether crawler is active",
          "default": true
        },
        "additional_sessions": {
          "type": "array",
          "description": "Further sessions beyond the first (converted to extra queues)",
          "items": {
            "$ref": "#/definitions/session"
          }
        },
        "agent": {
          "$ref": "#/definitions/agent"
        },
        "assign": {
          "type": "object",
          "description": "Per-crawler pool draws: each name takes one row of a pool, without replacement across crawlers, and exposes its columns as {name.column} placeholders anywhere in this crawler",
          "additionalProperties": {
            "$ref": "#/definitions/assignment"
          }
        },
        "configuration": {
          "$ref": "#/definitions/configuration"
        },
        "description": {
          "type": "string",
          "description": "Crawler description"
        },
        "from_base": {
          "type": "boolean",
          "description": "Runs spec only: write one copy of this block per crawler of the base fleet lock, with {base.name} / {base.location} / {base.<preference>} substituted",
          "default": false
        },
        "from_design": {
          "type": "boolean",
          "description": "Whether to expand this crawler using the factorial design",
          "default": false
        },
        "name": {
          "type": "string",
          "description": "Crawler name (supports variable substitution)"
        },
        "proxy": {
          "$ref": "#/definitions/proxy"
        },
        "queues": {
          "type": "array",
          "description": "Queue definitions (alternative to session/additional_sessions)",
          "items": {
            "$ref": "#/definitions/session"
          }
        },
        "session": {
          "$ref": "#/definitions/session"
        },
        "testing": {
          "type": "boolean",
          "description": "Whether crawler is in testing mode",
          "default": false
        },
        "updates": {
          "type": "object",
          "description": "Runs spec only: preference values to change on the existing bot when this lock is uploaded",
          "properties": {
            "preferences": {
              "type": "object",
              "description": "Preference name -> new value",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "description": "One pool row drawn for this crawler, substitutable as {name.column}",
      "properties": {
        "from_pool": {
          "type": "string",
          "description": "Name of a declared data pool"
        },
        "match_field": {
          "type": "string",
          "description": "Pool column compared with the crawler's agent.location (or with match_value); omit to draw from any row"
        },
        "match_value": {
          "type": "string",
          "description": "What match_field is compared with, instead of agent.location"
        },
        "select": {
          "type": "string",
          "description": "How a row is chosen among the free matching ones",
          "enum": [
            "first",
            "random"
          ],
          "default": "random"
        }
      },
      "additionalProperties": false,
      "required": [
        "from_pool"
      ]
    },
    "configuration": {
      "type": "object",
      "description": "Crawler configuration",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Whether the configuration is active"
        },
        "description": {
          "type": "string",
          "description": "Configuration description"
        },
        "name": {
          "type": "string",
          "description": "Configuration name"
        },
        "params": {
          "$ref": "#/definitions/params"
        },
        "preferences": {
          "type": "array",
          "description": "Preference settings",
          "items": {
            "$ref": "#/definitions/preference"
          }
        }
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "description": "Algorithm parameters read by the runner/decision function",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Whether the configuration is active"
        },
        "alpha": {
          "description": "Alpha parameter"
        },
        "beta": {
          "description": "Beta parameter"
        },
        "kappa": {
          "description": "Treatment switch; see docs/integration-contract.md and CLAUDE.md"
        },
        "media_outlet_urls": {
          "description": "Media outlet URLs with weights, or an unresolved data-pool reference",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "domain": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "pi": {
                    "type": "number"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "from_pool"
              ]
            }
          ]
        },
        "pi": {
          "description": "Treatment switch; see docs/integration-contract.md and CLAUDE.md"
        },
        "psi": {
          "description": "Treatment switch; see docs/integration-contract.md and CLAUDE.md"
        },
        "search_terms": {
          "description": "Search terms with weights, or an unresolved data-pool reference",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "term": {
                    "type": "string"
                  },
                  "pi": {
                    "type": "number"
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "from_pool"
              ]
            }
          ]
        },
        "tau": {
          "description": "Treatment switch; see docs/integration-contract.md and CLAUDE.md"
        }
      },
      "additionalProperties": true
    },
    "preference": {
      "type": "object",
      "description": "A configuration preference",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Preference name"
        },
        "value": {
          "description": "Preference value (string or JSON)"
        },
        "description": {
          "type": "string",
          "description": "Preference description"
        },
        "active": {
          "type": "boolean",
          "description": "Whether preference is active",
          "default": true
        }
      }
    },
    "proxy": {
      "type": "object",
      "description": "Proxy configuration",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Whether the proxy is active"
        },
        "description": {
          "type": "string",
          "description": "Proxy description"
        },
        "from_pool": {
          "type": "boolean",
          "description": "Assign this crawler its own row of a data pool (needs pool/match_field)"
        },
        "host": {
          "type": "string",
          "description": "Alias for hostname"
        },
        "hostname": {
          "type": "string",
          "description": "Proxy hostname or IP"
        },
        "location": {
          "type": "string",
          "description": "Geo-targeting location code"
        },
        "match_field": {
          "type": "string",
          "description": "Pool column to match against the agent's location"
        },
        "name": {
          "type": "string",
          "description": "Proxy name"
        },
        "password": {
          "type": "string",
          "description": "Proxy password"
        },
        "pool": {
          "type": "string",
          "description": "Pool name to draw a proxy row from"
        },
        "port": {
          "type": "integer",
          "description": "Proxy port",
          "minimum": 1,
          "maximum": 65535
        },
        "type": {
          "type": "string",
          "description": "Proxy type",
          "enum": [
            "http",
            "brightdata",
            "oxylabs"
          ]
        },
        "username": {
          "type": "string",
          "description": "Proxy username"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "description": "Browser agent configuration",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Whether the agent is active"
        },
        "custom_start_urls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Startup URLs; switches the profile to a custom startup behaviour"
        },
        "description": {
          "type": "string",
          "description": "Agent description"
        },
        "identification": {
          "type": "string",
          "description": "Browser identification type",
          "enum": [
            "mlx",
            "chrome",
            "firefox"
          ]
        },
        "location": {
          "type": "string",
          "description": "Agent location code"
        },
        "multilogin_id": {
          "type": "string",
          "description": "Existing Multilogin profile ID"
        },
        "multilogin_profile": {
          "type": "object",
          "description": "Multilogin profile configuration overrides"
        },
        "name": {
          "type": "string",
          "description": "Agent name"
        }
      },
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "description": "Session/queue definition",
      "properties": {
        "active": {
          "type": "boolean",
          "description": "Whether the session is active",
          "default": true
        },
        "description": {
          "type": "string",
          "description": "Session description"
        },
        "jobs": {
          "type": "array",
          "description": "Full job definitions (alternative to workflow)",
          "items": {
            "$ref": "#/definitions/job"
          }
        },
        "name": {
          "type": "string",
          "description": "Session name"
        },
        "start": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/startJitter"
            }
          ],
          "description": "Start time: 'now', relative offset (+5m, +1h, +1d), ISO 8601 timestamp, or {from, jitter} for a seeded start within a window",
          "examples": [
            "now",
            "+5m",
            "+1h",
            "+1d",
            "2025-02-01T10:00:00Z"
          ]
        },
        "start_at": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/startJitter"
            }
          ],
          "description": "Alias for start: 'now', relative offset (+5m, +1h, +1d), ISO 8601 timestamp, or {from, jitter} for a seeded start within a window",
          "examples": [
            "now",
            "+5m",
            "+1h",
            "+1d",
            "2025-02-01T10:00:00Z"
          ]
        },
        "timezone": {
          "type": "string",
          "description": "Session timezone"
        },
        "timezone_utc_offset": {
          "type": "string",
          "description": "UTC offset"
        },
        "workflow": {
          "type": "array",
          "description": "Workflow steps",
          "items": {
            "$ref": "#/definitions/workflowItem"
          }
        }
      },
      "additionalProperties": false
    },
    "startJitter": {
      "type": "object",
      "description": "A session start drawn from the lock's seed: from + U(0, jitter)",
      "properties": {
        "from": {
          "type": "string",
          "description": "The earliest start: 'now', a relative offset, or ISO 8601"
        },
        "jitter": {
          "type": "string",
          "description": "Width of the window the start is drawn from (e.g. '6h')"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "jitter"
      ]
    },
    "dataPool": {
      "type": "object",
      "description": "A data pool loaded from an external file (CSV/JSON/YAML)",
      "properties": {
        "source": {
          "type": "string",
          "description": "File path, relative to the spec"
        },
        "format": {
          "type": "string",
          "description": "File format; auto-detected from source if omitted",
          "enum": [
            "csv",
            "json",
            "yaml"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Expected columns (for documentation/validation)"
        },
        "column_mapping": {
          "type": "object",
          "description": "Rename source columns on load"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": true
    },
    "designParameter": {
      "description": "A parameter distribution (design.parameters.<name>): a `distribution:` object, a fixed `value:` shorthand with no 'distribution' key, or a bare scalar (DistributionFactory.create wraps a non-dict in FixedValue)",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "distribution": {
              "type": "string",
              "enum": [
                "uniform",
                "discrete",
                "normal",
                "gumbel",
                "truncated_normal",
                "beta",
                "fixed"
              ]
            },
            "value": {
              "description": "Fixed value shorthand"
            }
          },
          "additionalProperties": true
        },
        {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        }
      ]
    },
    "workflowItem": {
      "type": "object",
      "description": "A workflow step (job shorthand, template reference, or repeat block)",
      "properties": {
        "visit": {
          "type": "string",
          "description": "URL to visit"
        },
        "wait": {
          "oneOf": [
            {
              "type": [
                "integer",
                "number"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?\\s*[a-z]*$"
            },
            {
              "type": "object",
              "description": "A wait drawn from the lock's seed: U(min, max) seconds",
              "properties": {
                "max": {
                  "type": [
                    "integer",
                    "number",
                    "string"
                  ],
                  "description": "Longest wait (e.g. '60s')"
                },
                "min": {
                  "type": [
                    "integer",
                    "number",
                    "string"
                  ],
                  "description": "Shortest wait (e.g. '30s')"
                }
              },
              "additionalProperties": true,
              "required": [
                "min",
                "max"
              ]
            }
          ],
          "description": "Wait duration (e.g., 10, '10s', '5m') or a {min, max} range"
        },
        "click": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Click options",
              "properties": {
                "captcha_mode": {
                  "type": "string",
                  "enum": [
                    "never",
                    "always",
                    "ondemand"
                  ]
                },
                "flag": {
                  "type": "string"
                },
                "selection_type": {
                  "type": "string",
                  "enum": [
                    "XPATH",
                    "CSS",
                    "ID",
                    "NAME"
                  ]
                },
                "selector": {
                  "type": "string"
                },
                "task": {
                  "type": "string"
                }
              },
              "additionalProperties": true,
              "required": [
                "selector"
              ]
            }
          ],
          "description": "Element selector or click options"
        },
        "try_click": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "description": "Try-click options",
              "properties": {
                "captcha_mode": {
                  "type": "string",
                  "enum": [
                    "never",
                    "always",
                    "ondemand"
                  ]
                },
                "flag": {
                  "type": "string"
                },
                "selection_type": {
                  "type": "string",
                  "enum": [
                    "XPATH",
                    "CSS",
                    "ID",
                    "NAME"
                  ]
                },
                "selector": {
                  "type": "string"
                },
                "task": {
                  "type": "string"
                }
              },
              "additionalProperties": true,
              "required": [
                "selector"
              ]
            }
          ],
          "description": "Try to click (continues on failure)"
        },
        "type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "assertproxyjob",
                "clearstoragejob",
                "clickjob",
                "entertextfieldjob",
                "handlealertjob",
                "lambdasingleselectjob",
                "scrollbydurationjob",
                "scrollbylengthjob",
                "singleselectjob",
                "singleselecturljob",
                "switchjob",
                "tryclickjob",
                "tryentertextfieldjob",
                "tryhandlealertjob",
