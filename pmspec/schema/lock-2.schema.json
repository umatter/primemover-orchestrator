{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pmspec lock, format 2",
  "type": "object",
  "required": ["pmspec_lock", "provenance", "experiment", "schedule", "parts", "crawlers"],
  "additionalProperties": false,
  "properties": {
    "pmspec_lock": {"const": 2},
    "kind": {"enum": ["fleet", "runs"]},
    "provenance": {
      "type": "object",
      "required": ["spec_path", "spec_sha256", "pmspec_version", "seed"],
      "additionalProperties": false,
      "properties": {
        "spec_path": {"type": "string"},
        "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generator": {"type": ["string", "null"]},
        "git_commit": {"type": ["string", "null"]},
        "pmspec_version": {"type": "string"},
        "seed": {"type": "integer"},
        "lax": {"type": "boolean"},
        "pools": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "base_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_spec_path": {"type": "string"}
      }
    },
    "experiment": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "runner_user_id": {"type": ["integer", "null"]},
        "contact": {"type": ["string", "null"]}
      }
    },
    "schedule": {
      "type": "object",
      "required": ["anchor"],
      "additionalProperties": false,
      "properties": {"anchor": {"type": "string", "minLength": 1}}
    },
    "parts": {
      "type": "object",
      "required": ["queues", "agents"],
      "additionalProperties": false,
      "properties": {
        "queues": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["name", "jobs"],
            "not": {"anyOf": [{"required": ["start_at"]}, {"required": ["start_offset"]}]},
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "jobs": {"type": "array"},
              "start_at": false,
              "start_offset": false
            }
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "not": {"required": ["name"]},
            "properties": {"name": false}
          }
        }
      }
    },
    "crawlers": {
      "type": "array",
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "runs"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "crawlers": {
            "items": {
              "type": "object",
              "required": ["name", "queues"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "queues": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["ref", "start_offset"],
                    "not": {"anyOf": [{"required": ["start_at"]}, {"required": ["jobs"]}]},
                    "additionalProperties": false,
                    "properties": {
                      "ref": {"type": "string", "pattern": "^q:[0-9a-f]{16}$"},
                      "start_offset": {"type": "string", "pattern": "^[+-][0-9]+[smhd]$"},
                      "start_at": false,
                      "jobs": false
                    }
                  }
                },
                "updates": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "preferences": {
                      "type": "object",
                      "additionalProperties": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "crawlers": {
            "items": {
              "type": "object",
              "required": ["name", "configuration", "queues"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "configuration": {"type": "object"},
                "proxy": {"type": "object"},
                "agent": {
                  "type": "object",
                  "required": ["ref"],
                  "additionalProperties": false,
                  "properties": {
                    "ref": {"type": "string", "pattern": "^a:[0-9a-f]{16}$"},
                    "name": {}
                  }
                },
                "queues": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["ref", "start_offset"],
                    "not": {"anyOf": [{"required": ["start_at"]}, {"required": ["jobs"]}]},
                    "additionalProperties": false,
                    "properties": {
                      "ref": {"type": "string", "pattern": "^q:[0-9a-f]{16}$"},
                      "start_offset": {"type": "string", "pattern": "^[+-][0-9]+[smhd]$"},
                      "start_at": false,
                      "jobs": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
