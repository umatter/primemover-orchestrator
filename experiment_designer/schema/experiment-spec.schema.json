{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://primemover.io/schemas/experiment-spec.schema.json",
  "title": "PrimeMover Experiment Specification",
  "description": "YAML/JSON schema for defining PrimeMover browser automation experiments",
  "type": "object",
  "required": ["experiment", "crawlers"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Specification version",
      "default": "1.0",
      "examples": ["1.0"]
    },
    "experiment": {
      "$ref": "#/definitions/experiment"
    },
    "defaults": {
      "$ref": "#/definitions/defaults"
    },
    "templates": {
      "type": "object",
      "description": "Reusable workflow templates",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/workflowItem"
        }
      }
    },
    "design": {
      "$ref": "#/definitions/design"
    },
    "crawlers": {
      "type": "array",
      "description": "Crawler definitions",
      "items": {
        "$ref": "#/definitions/crawler"
      },
      "minItems": 1
    }
  },
  "definitions": {
    "experiment": {
      "type": "object",
      "description": "Experiment metadata",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Experiment name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Experiment description"
        },
        "runner_user_id": {
          "type": "integer",
          "description": "Runner account that executes this experiment; omit for the default runner (1 = ex63). 3 = the runner-only VM."
        },
        "generator": {
          "type": "string",
          "description": "Free-text provenance: what produced this spec"
        }
      }
    },
    "defaults": {
      "type": "object",
      "description": "Default values inherited by all crawlers",
      "properties": {
        "location": {
          "type": "string",
          "description": "Default location code",
          "examples": ["US-IL-CHICAGO", "US-CA-LOS_ANGELES", "DE-BE-BERLIN"]
        },
        "browser": {
          "type": "string",
          "description": "Browser identification",
          "enum": ["mlx", "chrome", "firefox"],
          "default": "mlx"
        },
        "timezone": {
          "type": "string",
          "description": "Timezone identifier",
          "examples": ["America/Chicago", "America/New_York", "Europe/Berlin"]
        },
        "timezone_utc_offset": {
          "type": "string",
          "description": "UTC offset",
          "pattern": "^[+-]\\d{2}:\\d{2}$",
          "examples": ["-06:00", "+01:00"]
        },
        "captcha_mode": {
          "type": "string",
          "description": "Captcha handling mode",
          "enum": ["never", "always", "ondemand"],
          "default": "never"
        },
        "proxy_type": {
          "type": "string",
          "description": "Default proxy type",
          "enum": ["http", "socks5", "brightdata", "oxylabs"],
          "default": "http"
        },
        "typing_mode": {
          "type": "string",
          "description": "Text input simulation mode",
          "enum": ["INSTANT", "SIMULATED", "SIMULATED_FIXINGTYPOS"],
          "default": "SIMULATED_FIXINGTYPOS"
        },
        "selection_type": {
          "type": "string",
          "description": "Default element selection type",
          "enum": ["XPATH", "CSS", "ID", "NAME"],
          "default": "XPATH"
        }
      }
    },
    "design": {
      "type": "object",
      "description": "Factorial experimental design",
      "required": ["factors"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Design type",
          "enum": ["factorial"],
          "default": "factorial"
        },
        "factors": {
          "type": "object",
          "description": "Factor definitions",
          "additionalProperties": {
            "$ref": "#/definitions/factor"
          },
          "minProperties": 1
        },
        "replications": {
          "type": "integer",
          "description": "Number of replications per cell",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "factor": {
      "type": "object",
      "description": "A factor in the experimental design",
      "required": ["levels"],
      "properties": {
        "levels": {
          "type": "array",
          "description": "Factor levels",
          "items": {
            "oneOf": [
              {"type": "string"},
              {"type": "number"},
              {
                "type": "object",
                "properties": {
                  "id": {"type": "string"},
                  "name": {"type": "string"},
                  "value": {}
                }
              }
            ]
          },
          "minItems": 1
        },
        "maps_to": {
          "type": "object",
          "description": "Parameter mappings for each level",
          "additionalProperties": {
            "type": "object",
            "description": "Level-to-value mapping"
          }
        }
      }
    },
    "crawler": {
      "type": "object",
      "description": "Crawler definition",
      "properties": {
        "from_design": {
          "type": "boolean",
          "description": "Whether to expand this crawler using the factorial design",
          "default": false
        },
        "name": {
          "type": "string",
          "description": "Crawler name (supports variable substitution)"
        },
        "description": {
          "type": "string",
          "description": "Crawler description"
        },
        "active": {
          "type": "boolean",
          "description": "Whether crawler is active",
          "default": true
        },
        "testing": {
          "type": "boolean",
          "description": "Whether crawler is in testing mode",
          "default": false
        },
        "configuration": {
          "$ref": "#/definitions/configuration"
        },
        "proxy": {
          "$ref": "#/definitions/proxy"
        },
        "agent": {
          "$ref": "#/definitions/agent"
        },
        "session": {
          "$ref": "#/definitions/session"
        },
        "queues": {
          "type": "array",
          "description": "Queue definitions (alternative to session)",
          "items": {
            "$ref": "#/definitions/session"
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "description": "Crawler configuration",
      "properties": {
        "name": {
          "type": "string",
          "description": "Configuration name"
        },
        "description": {
          "type": "string",
          "description": "Configuration description"
        },
        "params": {
          "$ref": "#/definitions/params"
        },
        "preferences": {
          "type": "array",
          "description": "Preference settings",
          "items": {
            "$ref": "#/definitions/preference"
          }
        }
      }
    },
    "params": {
      "type": "object",
      "description": "Algorithm parameters",
      "properties": {
        "pi": {
          "enum": [0, 1],
          "description": "Treatment switch, NOT an intensity. Read by the decision function as int(round(x))==1, so use only 0 or 1 (0.5 rounds to 0 and silently disables the arm)."
        },
        "psi": {
          "enum": [0, 1],
          "description": "Treatment switch (0 or 1 only; see pi)."
        },
        "alpha": {
          "type": "number",
          "description": "Alpha parameter",
          "minimum": 0,
          "maximum": 1
        },
        "tau": {
          "enum": [0, 1],
          "description": "Treatment switch (0 or 1 only; see pi)."
        },
        "kappa": {
          "enum": [0, 1],
          "description": "Treatment switch (0 or 1 only; see pi)."
        },
        "beta": {
          "type": "number",
          "description": "Beta parameter"
        },
        "search_terms": {
          "type": "array",
          "description": "Search terms with weights",
          "items": {
            "type": "object",
            "properties": {
              "term": {"type": "string"},
              "pi": {"type": "number"}
            }
          }
        },
        "media_outlet_urls": {
          "type": "array",
          "description": "Media outlet URLs with weights",
          "items": {
            "type": "object",
            "properties": {
              "domain": {"type": "string"},
              "url": {"type": "string"},
              "pi": {"type": "number"}
            }
          }
        }
      }
    },
    "preference": {
      "type": "object",
      "description": "A configuration preference",
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Preference name"
        },
        "value": {
          "description": "Preference value (string or JSON)"
        },
        "description": {
          "type": "string",
          "description": "Preference description"
        },
        "active": {
          "type": "boolean",
          "description": "Whether preference is active",
          "default": true
        }
      }
    },
    "proxy": {
      "type": "object",
      "description": "Proxy configuration",
      "properties": {
        "name": {
          "type": "string",
          "description": "Proxy name"
        },
        "hostname": {
          "type": "string",
          "description": "Proxy hostname or IP"
        },
        "host": {
          "type": "string",
          "description": "Alias for hostname"
        },
        "port": {
          "type": "integer",
          "description": "Proxy port",
          "minimum": 1,
          "maximum": 65535
        },
        "username": {
          "type": "string",
          "description": "Proxy username"
        },
        "password": {
          "type": "string",
          "description": "Proxy password"
        },
        "type": {
          "type": "string",
          "description": "Proxy type",
          "enum": ["http", "socks5", "brightdata", "oxylabs"]
        }
      }
    },
    "agent": {
      "type": "object",
      "description": "Browser agent configuration",
      "properties": {
        "name": {
          "type": "string",
          "description": "Agent name"
        },
        "description": {
          "type": "string",
          "description": "Agent description"
        },
        "identification": {
          "type": "string",
          "description": "Browser identification type",
          "enum": ["mlx", "chrome", "firefox"]
        },
        "location": {
          "type": "string",
          "description": "Agent location code"
        },
        "multilogin_id": {
          "type": "string",
          "description": "Existing Multilogin profile ID"
        },
        "multilogin_profile": {
          "type": "object",
          "description": "Multilogin profile configuration"
        }
      }
    },
    "session": {
      "type": "object",
      "description": "Session/queue definition",
      "properties": {
        "name": {
          "type": "string",
          "description": "Session name"
        },
        "description": {
          "type": "string",
          "description": "Session description"
        },
        "start": {
          "type": "string",
          "description": "Start time: 'now', relative offset (+5m, +1h, +1d), or ISO 8601 timestamp",
          "examples": ["now", "+5m", "+1h", "+1d", "2025-02-01T10:00:00Z"]
        },
        "start_at": {
          "type": "string",
          "description": "Alias for start: 'now', relative offset (+5m, +1h, +1d), or ISO 8601 timestamp",
          "examples": ["now", "+5m", "+1h", "+1d", "2025-02-01T10:00:00Z"]
        },
        "timezone": {
          "type": "string",
          "description": "Session timezone"
        },
        "timezone_utc_offset": {
          "type": "string",
          "description": "UTC offset"
        },
        "schedule": {
          "type": "string",
          "description": "Scheduling pattern",
          "enum": ["once", "daily", "weekly"]
        },
        "active": {
          "type": "boolean",
          "description": "Whether session is active",
          "default": true
        },
        "workflow": {
          "type": "array",
          "description": "Workflow steps",
          "items": {
            "$ref": "#/definitions/workflowItem"
          }
        },
        "jobs": {
          "type": "array",
          "description": "Job definitions (alternative to workflow)",
          "items": {
            "$ref": "#/definitions/job"
          }
        }
      }
    },
    "workflowItem": {
      "type": "object",
      "description": "A workflow step (shorthand or full job)",
      "properties": {
        "visit": {
          "type": "string",
          "description": "URL to visit"
        },
        "wait": {
          "oneOf": [
            {"type": "integer"},
            {"type": "string", "pattern": "^\\d+[smh]?$"}
          ],
          "description": "Wait duration (e.g., 10, '10s', '5m')"
        },
        "click": {
          "oneOf": [
            {"type": "string"},
            {"$ref": "#/definitions/clickOptions"}
          ],
          "description": "Element selector or click options"
        },
        "try_click": {
          "oneOf": [
            {"type": "string"},
            {"$ref": "#/definitions/clickOptions"}
          ],
          "description": "Try to click (continues on failure)"
        },
        "type": {
          "$ref": "#/definitions/typeOptions",
          "description": "Type text into field"
        },
        "try_type": {
          "$ref": "#/definitions/typeOptions",
          "description": "Try to type (continues on failure)"
        },
        "scroll": {
          "oneOf": [
            {"type": "integer"},
            {"type": "string"},
            {"$ref": "#/definitions/scrollOptions"}
          ],
          "description": "Scroll duration or options"
        },
        "scroll_length": {
          "oneOf": [
            {"type": "integer"},
            {"$ref": "#/definitions/scrollLengthOptions"}
          ],
          "description": "Scroll by pixel amount"
        },
        "try_scroll": {
          "oneOf": [
            {"type": "integer"},
            {"type": "string"},
            {"$ref": "#/definitions/scrollOptions"}
          ],
          "description": "Best-effort scroll by duration (does not fail the job on error)"
        },
        "try_scroll_length": {
          "oneOf": [
            {"type": "integer"},
            {"$ref": "#/definitions/scrollLengthOptions"}
          ],
          "description": "Best-effort scroll by pixel amount (does not fail the job on error)"
        },
        "lambda_select": {
          "$ref": "#/definitions/lambdaSelectOptions",
          "description": "AWS Lambda element selection"
        },
        "single_select": {
          "oneOf": [
            {"type": "string"},
            {"type": "object"}
          ],
          "description": "Select single element"
        },
        "template": {
          "type": "string",
          "description": "Template name to expand"
        },
        "with": {
          "type": "object",
          "description": "Variables to pass to template"
        },
        "repeat": {
          "type": "integer",
          "description": "Number of times to repeat",
          "minimum": 1
        },
        "handle_alert": {
          "oneOf": [
            {"type": "string", "enum": ["accept", "dismiss"]},
            {"type": "object"}
          ],
          "description": "Handle browser alert"
        },
        "try_handle_alert": {
          "oneOf": [
            {"type": "string", "enum": ["accept", "dismiss"]},
            {"type": "object"}
          ],
          "description": "Try to handle alert"
        },
        "switch": {
          "oneOf": [
            {"type": "string"},
            {"type": "object"}
          ],
          "description": "Switch to frame/window"
        },
        "try_switch": {
          "oneOf": [
            {"type": "string"},
            {"type": "object"}
          ],
          "description": "Try to switch"
        }
      }
    },
    "clickOptions": {
      "type": "object",
      "properties": {
        "selector": {"type": "string"},
        "selection_type": {"type": "string", "enum": ["XPATH", "CSS", "ID", "NAME"]},
        "task": {"type": "string"},
        "flag": {"type": "string"},
        "captcha_mode": {"type": "string", "enum": ["never", "always", "ondemand"]}
      },
      "required": ["selector"]
    },
    "typeOptions": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "selector": {"type": "string"},
        "selection_type": {"type": "string", "enum": ["XPATH", "CSS", "ID", "NAME"]},
        "submit": {"type": "boolean"},
        "typing_mode": {"type": "string", "enum": ["INSTANT", "SIMULATED", "SIMULATED_FIXINGTYPOS"]},
        "captcha_mode": {"type": "string", "enum": ["never", "always", "ondemand"]}
      },
      "required": ["text", "selector"]
    },
    "scrollOptions": {
      "type": "object",
      "properties": {
        "duration": {"type": "integer"},
        "direction": {"type": "string", "enum": ["UP", "DOWN", "LEFT", "RIGHT"]},
        "captcha_mode": {"type": "string"}
      }
    },
    "scrollLengthOptions": {
      "type": "object",
      "properties": {
        "pixels": {"type": "integer"},
        "direction": {"type": "string", "enum": ["UP", "DOWN", "LEFT", "RIGHT"]},
        "captcha_mode": {"type": "string"}
      }
    },
    "lambdaSelectOptions": {
      "type": "object",
      "properties": {
        "task": {"type": "string"},
        "function": {"type": "string"},
        "link_value": {"type": "string"},
        "link_type": {"type": "string", "enum": ["FUNCTION_NAME", "ARN"]},
        "captcha_mode": {"type": "string"}
      },
      "required": ["task"]
    },
    "job": {
      "type": "object",
      "description": "Full job definition",
      "required": ["type"],
      "properties": {
        "name": {"type": "string"},
        "type": {
          "type": "string",
          "enum": [
            "visitjob", "waitjob", "clickjob", "tryclickjob",
            "entertextfieldjob", "tryentertextfieldjob",
            "scrollbydurationjob", "scrollbylengthjob",
            "lambdasingleselectjob", "singleselectjob", "singleselecturljob",
            "switchjob", "tryswitchjob",
            "handlealertjob", "tryhandlealertjob"
          ]
        },
        "description": {"type": "string"},
        "active": {"type": "boolean", "default": true},
        "behaviors": {
          "oneOf": [
            {
              "type": "array",
              "items": {"$ref": "#/definitions/behavior"}
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        }
      }
    },
    "behavior": {
      "type": "object",
      "description": "Job behavior parameter",
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string"},
        "value": {},
        "description": {"type": "string"},
        "active": {"type": "boolean", "default": true}
      }
    }
  }
}
